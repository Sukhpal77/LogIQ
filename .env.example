# ----- Backend -----
APP_ENV=dev
LOG_LEVEL=info

# ----- Database -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=logiq
POSTGRES_USER=logiq
POSTGRES_PASSWORD=logiq

# ----- Redis -----
REDIS_URL=redis://redis:6379/0
LOG_STREAM=logiq.logs
METRIC_STREAM=logiq.metrics
CONSUMER_GROUP=logiq-workers

# ----- Auth -----
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USER=admin
ADMIN_PASSWORD=admin
INGEST_API_KEY=
CORS_ORIGINS=http://localhost:3000
ANALYSIS_INTERVAL_SECONDS=60
ANALYSIS_WINDOW_MINUTES=15
RETENTION_DAYS=30

# ----- LLM -----
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBED_MODEL=text-embedding-3-small

# ----- Anomaly thresholds -----
ZSCORE_THRESHOLD=2.5
EWMA_ALPHA=0.3
EWMA_THRESHOLD=2.0
RULE_CPU=80
RULE_MEM=85
RULE_LATENCY=1000

# ----- Actions (optional) -----

# SaaS launch configuration (sandbox remains the local default)
PUBLIC_URL=http://localhost:3000
BILLING_PROVIDER=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SECRETS_ENCRYPTION_KEY=
ADMIN_EMAIL=
